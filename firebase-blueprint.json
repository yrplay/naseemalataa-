{
  "entities": {
    "SiteContent": {
      "title": "SiteContent",
      "description": "Public CMS state for Naseem Al-Ataa Trading Company synchronized across all devices.",
      "type": "object",
      "properties": {
        "payloadJson": {
          "type": "string",
          "description": "Serialized public CMS state (categories, products, company info, theme, pages).",
          "minLength": 2,
          "maxLength": 900000
        },
        "updatedBy": {
          "type": "string",
          "description": "UID of the admin who published the update.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "version": {
          "type": "number",
          "description": "Monotonically increasing revision number."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": ["payloadJson", "updatedBy", "version", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized administrator record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "addedBy": {
          "type": "string",
          "description": "UID of the super admin who granted access.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin record was created."
        }
      },
      "required": ["uid", "addedBy", "createdAt"]
    }
  },
  "firestore": {
    "/site_content/{docId}": {
      "schema": { "$ref": "#/entities/SiteContent" },
      "description": "Publicly readable website CMS state document (docId = 'main') updated by authorized admins."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Collection of authorized admin UIDs managed by the primary admin."
    }
  }
}
