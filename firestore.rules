rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Tier 1: Super Admin (Owner email or UID in /admins/{uid})
    function isSuperAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'yr.play.com@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAdmin() {
      return isSuperAdmin();
    }

    // Tier 1 or Tier 2 Authorized Staff (listed in /site_content/main authorizedEmails)
    function isAuthorizedStaff() {
      return isVerifiedUser() && (
        isSuperAdmin() ||
        (
          exists(/databases/$(database)/documents/site_content/main) &&
          request.auth.token.email in get(/databases/$(database)/documents/site_content/main).data.authorizedEmails
        )
      );
    }

    // Validation Blueprint for SiteContent (with Pillar 5 Total Array Guarding on authorizedEmails)
    function isValidSiteContent(data) {
      return data.keys().hasAll(['payloadJson', 'authorizedEmails', 'updatedBy', 'version', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['payloadJson', 'authorizedEmails', 'updatedBy', 'version', 'createdAt', 'updatedAt']) &&
        data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 900000 &&
        data.authorizedEmails is list && data.authorizedEmails.size() >= 1 && data.authorizedEmails.size() <= 50 &&
        data.authorizedEmails[0] is string && data.authorizedEmails[0].size() >= 3 && data.authorizedEmails[0].size() <= 128 &&
        data.updatedBy is string && isValidId(data.updatedBy) && data.updatedBy == request.auth.uid &&
        data.version is int && data.version >= 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint for SiteMedia
    function isValidSiteMedia(data, targetMediaId) {
      return data.keys().hasAll(['mediaId', 'dataUrl', 'updatedBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['mediaId', 'dataUrl', 'updatedBy', 'createdAt', 'updatedAt']) &&
        data.mediaId is string && isValidId(data.mediaId) && data.mediaId == targetMediaId &&
        data.dataUrl is string && data.dataUrl.size() >= 5 && data.dataUrl.size() <= 850000 &&
        data.updatedBy is string && isValidId(data.updatedBy) && data.updatedBy == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint for AdminRecord
    function isValidAdminRecord(data, targetUid) {
      return data.keys().hasAll(['uid', 'addedBy', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'addedBy', 'createdAt']) &&
        data.uid is string && isValidId(data.uid) && data.uid == targetUid &&
        data.addedBy is string && isValidId(data.addedBy) && data.addedBy == request.auth.uid &&
        data.createdAt is timestamp;
    }

    // Public CMS state synchronized across all devices
    match /site_content/{docId} {
      allow get: if isValidId(docId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(docId) &&
        isValidSiteContent(incoming()) &&
        incoming().version == 1 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isSuperAdmin();

      // Pillar 4 Tiered Identity Logic + Monotonic Version Increment:
      // - Tier 1 (isSuperAdmin()): Can update payloadJson and authorizedEmails
      // - Tier 2 (Authorized Staff in existing().authorizedEmails): Can update payloadJson only, cannot modify authorizedEmails
      allow update: if isVerifiedUser() &&
        isValidId(docId) &&
        isValidSiteContent(incoming()) &&
        incoming().version == resource.data.version + 1 &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['payloadJson', 'authorizedEmails', 'updatedBy', 'version', 'updatedAt']) &&
            isSuperAdmin()
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['payloadJson', 'updatedBy', 'version', 'updatedAt']) &&
            incoming().authorizedEmails == existing().authorizedEmails &&
            request.auth.token.email in existing().authorizedEmails &&
            isAuthorizedStaff()
          )
        );

      allow delete: if false;
    }

    // High-resolution media assets (banners, product photos) referenced by /site_content/main
    match /site_media/{mediaId} {
      allow get: if isValidId(mediaId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(mediaId) &&
        isValidSiteMedia(incoming(), mediaId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAuthorizedStaff();

      allow update: if isVerifiedUser() &&
        isValidId(mediaId) &&
        isValidSiteMedia(incoming(), mediaId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['dataUrl', 'updatedBy', 'updatedAt']) &&
        isAuthorizedStaff();

      allow delete: if isVerifiedUser() && isValidId(mediaId) && isSuperAdmin();
    }

    // Admin registry (prevents super admin from deleting their own record)
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidId(adminUid) && (request.auth.uid == adminUid || isSuperAdmin());
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(adminUid) &&
        isValidAdminRecord(incoming(), adminUid) &&
        incoming().createdAt == request.time &&
        isSuperAdmin();

      allow update: if false;

      allow delete: if isVerifiedUser() &&
        isValidId(adminUid) &&
        adminUid != request.auth.uid &&
        isSuperAdmin();
    }
  }
}
